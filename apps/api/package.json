{
  "name": "@doubtless/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/app.ts"
  },
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port 8787",
    "deploy": "wrangler deploy --env production",
    "types": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@doubtless/db": "workspace:*",
    "@doubtless/schemas": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}

{
  "name": "doubtless",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @doubtless/db generate",
    "db:migrate": "pnpm --filter @doubtless/db migrate",
    "db:check": "pnpm --filter @doubtless/db check",
    "e2e": "pnpm --filter @doubtless/web e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
